<?xml version='1.0' encoding='utf-8'?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code>extensions [csv]

globals [
  poblacion infectados-iniciales beta gamma tiempo-maximo semilla
  datos-java datos-netlogo segundos-calculo
]

turtles-own [estado siguiente-estado]

to setup
  clear-all
  set poblacion 100
  set infectados-iniciales 5
  set beta 0.30
  set gamma 0.10
  set tiempo-maximo 100
  set semilla 42
  set datos-java []
  set datos-netlogo []
  set segundos-calculo 0
  random-seed semilla
  ask patches [set pcolor white]

  ; La distribucion y el movimiento son visuales, no contactos por cercania.
  with-local-randomness [
    create-turtles poblacion [
      setxy random-xcor random-ycor
      set shape "person"
      set size 1.4
      set estado "S"
      if who &lt; infectados-iniciales [set estado "I"]
      if who = 0 [set label "P0" set label-color black set size 1.8]
      pintar
    ]
  ]
  reset-ticks
  registrar-netlogo
  if file-exists? "resultados_java.csv" [cargar-java]
end

to go
  if ticks &gt;= tiempo-maximo [stop]
  reset-timer
  avanzar-estados
  set segundos-calculo segundos-calculo + timer
  with-local-randomness [
    ask turtles [rt (random 61 - 30) fd 0.35]
  ]
  tick
  registrar-netlogo
  display
  ; Esta pausa no cambia el paso del modelo y no se incluye en el tiempo de calculo.
  if pausa &gt; 0 [wait pausa]
end

to avanzar-estados
  ask turtles [set siguiente-estado estado]
  ; Orden estable y estados anteriores: los nuevos infectados esperan al proximo paso.
  foreach sort turtles with [estado = "I"] [persona -&gt;
    ask persona [
      let contacto one-of other turtles
      if [estado] of contacto = "S" [
        if random-float 1 &lt; beta [
          ask contacto [set siguiente-estado "I"]
        ]
      ]
      if random-float 1 &lt; gamma [set siguiente-estado "R"]
    ]
  ]
  ask turtles [set estado siguiente-estado pintar]
end

to pintar
  if estado = "S" [set color blue]
  if estado = "I" [set color red]
  if estado = "R" [set color green - 1]
end

to registrar-netlogo
  let fila (list ticks (count turtles with [estado = "S"])
    (count turtles with [estado = "I"]) (count turtles with [estado = "R"]))
  set datos-netlogo lput fila datos-netlogo
  dibujar-evolucion "Evolucion NetLogo" fila
  dibujar-comparaciones "NetLogo" fila
end

to cargar-java
  if not file-exists? "resultados_java.csv" [
    user-message "Falta resultados_java.csv. Ejecuta Java desde la raiz del proyecto."
    stop
  ]
  ; Se valida antes de reemplazar los resultados ya cargados.
  let filas csv:from-file "resultados_java.csv"
  if empty? filas [error "El CSV esta vacio."]
  if first filas != ["tiempo" "susceptibles" "infectados" "recuperados"] [
    error "El encabezado debe ser: tiempo,susceptibles,infectados,recuperados"
  ]
  let nuevos but-first filas
  if length nuevos != tiempo-maximo + 1 [error "Se esperan los tiempos 0 a 100."]
  let tiempo-esperado 0
  foreach nuevos [fila -&gt;
    if length fila != 4 [error "Cada fila debe contener tiempo, S, I y R."]
    foreach fila [valor -&gt;
      if not is-number? valor [error "El CSV debe contener numeros enteros."]
      if valor &lt; 0 or valor != floor valor [error "Hay valores negativos o no enteros."]
    ]
    if item 0 fila != tiempo-esperado [error "Los tiempos deben ser consecutivos desde 0."]
    if sum but-first fila != poblacion [error "En cada fila debe cumplirse S + I + R = 100."]
    set tiempo-esperado tiempo-esperado + 1
  ]
  if first nuevos != [0 95 5 0] [error "El estado inicial debe ser 0,95,5,0."]
  set datos-java nuevos
  set-current-plot "Evolucion Java"
  clear-plot
  foreach ["Comparacion S" "Comparacion I" "Comparacion R"] [nombre -&gt;
    set-current-plot nombre
    clear-plot
  ]
  foreach datos-java [fila -&gt;
    dibujar-evolucion "Evolucion Java" fila
    dibujar-comparaciones "Java" fila
  ]
  foreach datos-netlogo [fila -&gt; dibujar-comparaciones "NetLogo" fila]
end

to dibujar-evolucion [nombre fila]
  set-current-plot nombre
  set-current-plot-pen "S"
  plotxy (item 0 fila) (item 1 fila)
  set-current-plot-pen "I"
  plotxy (item 0 fila) (item 2 fila)
  set-current-plot-pen "R"
  plotxy (item 0 fila) (item 3 fila)
end

to dibujar-comparaciones [origen fila]
  let columna 1
  foreach ["Comparacion S" "Comparacion I" "Comparacion R"] [nombre -&gt;
    set-current-plot nombre
    set-current-plot-pen origen
    plotxy (item 0 fila) (item columna fila)
    set columna columna + 1
  ]
end
</code>
