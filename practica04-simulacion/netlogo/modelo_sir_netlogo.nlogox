    <view x="10" y="110" width="352" height="352" minPxcor="-17" maxPxcor="17" minPycor="-17" maxPycor="17" patchSize="10" fontSize="11" frameRate="30" wrappingAllowedX="true" wrappingAllowedY="true" showTickCounter="true" tickCounterLabel="Tiempo" updateMode="1" />
