      <pen display="R" interval="1.0" mode="0" color="-10899396" legend="true">
        <setup />
        <update />
      </pen>
    </plot>
    <plot x="10" y="505" width="355" height="225" display="Comparacion S" xAxis="Tiempo" yAxis="Personas" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="false" autoPlotY="false" legend="true">
      <setup />
      <update />
      <pen display="Java" interval="1.0" mode="0" color="-16777216" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="NetLogo" interval="1.0" mode="0" color="-955883" legend="true">
        <setup />
        <update />
      </pen>
    </plot>
    <plot x="390" y="505" width="355" height="225" display="Comparacion I" xAxis="Tiempo" yAxis="Personas" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="false" autoPlotY="false" legend="true">
      <setup />
      <update />
      <pen display="Java" interval="1.0" mode="0" color="-16777216" legend="true">
        <setup />
