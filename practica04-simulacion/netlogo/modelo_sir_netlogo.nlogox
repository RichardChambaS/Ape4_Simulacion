    <plot x="760" y="110" width="365" height="350" display="Evolucion Java" xAxis="Tiempo" yAxis="Personas" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="false" autoPlotY="false" legend="true">
      <setup />
      <update />
      <pen display="S" interval="1.0" mode="0" color="-13345367" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="I" interval="1.0" mode="0" color="-2674135" legend="true">
        <setup />
